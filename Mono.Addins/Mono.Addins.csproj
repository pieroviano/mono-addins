<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\mono-addins.snk</AssemblyOriginatorKeyFile>
    <PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
    <!-- keep the hand-written AssemblyInfo.cs (has InternalsVisibleTo + version) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PackageId>Mono.Addins</PackageId>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- legacy source; don't fail the migration build on obsolete/warning noise -->
    <NoWarn>$(NoWarn);CS0618;SYSLIB0011;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
  <Import Project="..\Version.props" />
  <ItemGroup>
    <!-- net10 migration: SDK globbing picks up this root-level orphan that the legacy explicit Compile list
         excluded (the real type lives in Mono.Addins/CustomConditionAttribute.cs). Remove the duplicate. -->
    <Compile Remove="CustomConditionAttribute.cs" />
    <!-- net10 migration: SetupDomain uses AppDomain.CreateDomain + System.Runtime.Remoting (both removed on net10);
         it is dead now that GetSetupHandler always returns the in-process SetupLocal. -->
    <Compile Remove="Mono.Addins.Database\SetupDomain.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- net10 migration: netstandard2.0 does not expose System.Reflection.Emit.AssemblyBuilder
         (used only for `is AssemblyBuilder` guards); supplied by this package. -->
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
  </ItemGroup>
</Project>